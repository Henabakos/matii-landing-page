# Caddy obtains and renews Let's Encrypt certificates for DOMAIN automatically.

{$DOMAIN} {
	encode zstd gzip
	header Strict-Transport-Security "max-age=31536000; includeSubDomains"
	reverse_proxy web:3000
}

# One canonical host: send www to the apex domain with a permanent redirect.
www.{$DOMAIN} {
	redir https://{$DOMAIN}{uri} permanent
}

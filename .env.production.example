# Copy to .env.production on the VPS and fill in. Never commit the real file.

# Public hostname Caddy serves and requests a TLS certificate for (no scheme).
# Use "localhost" to try the full stack on your own machine.
DOMAIN="matiitechnologies.com"

# Image that scripts/deploy.sh pulls (built by .github/workflows/deploy.yml).
IMAGE_REPOSITORY="ghcr.io/henabakos/matii-landing-page"

# Build-time values (changing them requires `docker compose ... up -d --build`).
NEXT_PUBLIC_SITE_URL="https://matiitechnologies.com"
# true only for the real production server; staging must stay false.
SEO_INDEXING_ENABLED="true"
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=""

# Bundled PostgreSQL. The app's DATABASE_URL is built from these in
# docker-compose.yml. Use a URL-safe password, e.g. `openssl rand -hex 24`.
POSTGRES_USER="matii"
POSTGRES_PASSWORD="replace-with-openssl-rand-hex-24"
POSTGRES_DB="matii"

# Runtime values
ADMIN_PASSWORD="replace-with-a-strong-password"
GOOGLE_SITE_VERIFICATION=""
BING_SITE_VERIFICATION=""
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
OPENAI_API_KEY=""
GEMINI_API_KEY=""

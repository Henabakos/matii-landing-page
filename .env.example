# Neon pooled connection for application queries (hostname contains -pooler).
DATABASE_URL="postgresql://USER:PASSWORD@ep-YOUR-ENDPOINT-pooler.REGION.aws.neon.tech/neondb?sslmode=require&connect_timeout=15"
# Neon direct connection for Prisma migrations (same database, without -pooler).
DIRECT_URL="postgresql://USER:PASSWORD@ep-YOUR-ENDPOINT.REGION.aws.neon.tech/neondb?sslmode=require&connect_timeout=15"

ADMIN_PASSWORD="replace-with-a-strong-password"
NEXT_PUBLIC_SITE_URL="https://matiitechnologies.com"
# auto enables verified Vercel/Netlify production; previews remain noindex.
# Use true for production on other hosts; false explicitly disables indexing.
SEO_INDEXING_ENABLED="auto"
GOOGLE_SITE_VERIFICATION=""
BING_SITE_VERIFICATION=""
CLOUDINARY_CLOUD_NAME=""
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
OPENAI_API_KEY=""
GEMINI_API_KEY=""
